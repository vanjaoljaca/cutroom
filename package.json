{
  "name": "my-video-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/BuildCutroomServer.ts && node scripts/prepare-sites-build.mjs",
    "check": "npm run typecheck && npm run test",
    "preview": "vite preview",
    "test": "vitest run",
    "asset:import": "vite-node scripts/ImportProjectAsset.ts",
    "asset:remove": "vite-node scripts/RemoveProjectAsset.ts",
    "bundle:create": "vite-node scripts/CreateImageBundle.ts",
    "bundle:add": "vite-node scripts/AddImageBundleCandidate.ts",
    "bundle:remove": "vite-node scripts/RemoveImageBundle.ts",
    "bundle:select": "vite-node scripts/SelectImageBundleCandidate.ts",
    "overlay:attach": "vite-node scripts/AttachImageOverlay.ts",
    "overlay:set": "vite-node scripts/SetImageOverlay.ts",
    "video-overlay:attach": "vite-node scripts/AttachVideoOverlay.ts",
    "text:attach": "vite-node scripts/AttachTextOverlay.ts",
    "captions:generate": "vite-node scripts/GenerateCaptions.ts",
    "subtitles": "vite-node scripts/Subtitles.ts",
    "overlay:bundle": "vite-node scripts/AttachBundleToOverlay.ts",
    "overlay:remove": "vite-node scripts/RemoveProjectOverlay.ts",
    "pitch:analyze": "vite-node scripts/AnalyzeProjectPitch.ts",
    "video:create": "vite-node scripts/CreateVideoProject.ts",
    "recording:plan": "vite-node scripts/SetRecordingPlan.ts",
    "recording:link-raw": "vite-node scripts/LinkRawMediaProjects.ts",
    "program:source": "vite-node scripts/SetProgramSourceClip.ts",
    "raw-media": "vite-node scripts/RawMedia.ts",
    "video:export": "vite-node scripts/ExportVideo.ts",
    "review:serve-lan": "vite-node scripts/ServeLanReview.ts",
    "review:build": "vite-node scripts/BuildLanReview.ts",
    "media:reference:add": "vite-node scripts/AddReferenceMedia.ts",
    "media:reference:attach-cache": "vite-node scripts/AttachReferenceCache.ts",
    "media:reference:regenerate": "vite-node scripts/RegenerateReferenceMedia.ts",
    "media:reference:remove": "vite-node scripts/RemoveReferenceMedia.ts",
    "video:cutout": "vite-node scripts/CreateSubjectCutout.ts",
    "video:cutout:clean": "vite-node scripts/RemoveNonReadyCutouts.ts",
    "project:list": "vite-node scripts/ListProjects.ts",
    "project:load": "vite-node scripts/LoadProject.ts",
    "project:rename": "vite-node scripts/RenameProject.ts",
    "project:trash": "vite-node scripts/TrashProject.ts",
    "service:start": "node dist/server/CutroomServer.mjs",
    "service:update": "npm run build && vite-node scripts/UpdateCutroomService.ts",
    "typecheck": "tsc --noEmit",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "0.25.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
